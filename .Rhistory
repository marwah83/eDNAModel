RIKZ <- read.csv("https://oharar.github.io/TMA4315/Module08/RIKZ.csv")
summary(RIKZ)
library(lme4)
fit=lmer(Richness~NAP +(1|Beach),data=RIKZ)
summary(fit)
library(sjPlot)
install.packages("sjPlot")
library(sjPlot)
library(sjmisc)
library(ggplot2)
library(lme4)
fit=lmer(Richness~NAP +(1|Beach),data=RIKZ)
plot_model(fit,type="re",y.offset=0.4)
library(sjPlot)
library(sjmisc)
library(ggplot2)
