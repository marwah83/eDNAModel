library(dplyr)
library(ggplot2)
library(tidyr)
# Set treatment column
treatment_col <- "Samplingmonth"
# Prepare data
psi_data <- out$summary %>%
select(OTU, all_of(treatment_col), psi_mean, psi_lwr, psi_upr) %>%
group_by(OTU) %>%
mutate(otu_mean = mean(psi_mean, na.rm = TRUE)) %>%
ungroup() %>%
arrange(otu_mean) %>%
mutate(OTU = factor(OTU, levels = unique(OTU)))
# ✨ Complete missing combinations (to include all Samplingmonths per OTU)
psi_data_full <- psi_data %>%
complete(OTU, !!sym(treatment_col), fill = list(
psi_mean = NA, psi_lwr = NA, psi_upr = NA
))
# Plot
ggplot(psi_data_full, aes(x = psi_mean, y = OTU, color = .data[[treatment_col]])) +
geom_point(position = position_dodge(width = 0.6), na.rm = TRUE) +
geom_errorbarh(
aes(xmin = psi_lwr, xmax = psi_upr),
position = position_dodge(width = 0.6),
height = 0.2,
na.rm = TRUE
) +
labs(
title = "Caterpillar Plot: Occupancy Probability by OTU and Sampling Month",
x = "Occupancy Probability (ψ)",
y = "OTU",
color = treatment_col
) +
theme_minimal() +
theme(
axis.text.y = element_text(size = 7),
plot.title = element_text(hjust = 0.5)
)
# Define all 5 levels explicitly
treatment_levels <- levels(psi_data[[treatment_col]])
ggplot(psi_data_full, aes(x = psi_mean, y = OTU, color = .data[[treatment_col]])) +
geom_point(position = position_dodge(width = 0.6), na.rm = TRUE) +
geom_errorbarh(
aes(xmin = psi_lwr, xmax = psi_upr),
position = position_dodge(width = 0.6),
height = 0.2,
na.rm = TRUE
) +
scale_color_manual(
values = RColorBrewer::brewer.pal(n = length(treatment_levels), name = "Set2"),
breaks = treatment_levels,
drop = FALSE  # <-- Keeps unused levels in legend
) +
labs(
title = "Caterpillar Plot: Occupancy Probability by OTU and Sampling Month",
x = "Occupancy Probability (ψ)",
y = "OTU",
color = treatment_col
) +
theme_minimal() +
theme(
axis.text.y = element_text(size = 7),
plot.title = element_text(hjust = 0.5)
)
